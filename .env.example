# Cliente (seguro exponer en el frontend — depende de que RLS esté bien configurada)
# Rellenar con los valores que imprime `supabase start` en local,
# o con los del panel del proyecto en producción (Settings -> API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo servidor (Edge Functions) — JAMÁS en código de cliente.
# Se configuran como secretos en Supabase (`supabase secrets set`), no aquí en local
# salvo que estés probando Edge Functions en local con `supabase functions serve`.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
